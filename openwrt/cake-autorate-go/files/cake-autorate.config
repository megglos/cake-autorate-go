# Configuration of cake-autorate-go. An empty or missing option uses the
# default value of the program (see "cake-autorate-go -defaults").
# The download keys have the prefix "dl_", the upload keys "ul_".

config global 'global'
	option enabled '0'

config link 'wan'
	option name 'wan'
	option dl_interface 'ifb4wan'
	option dl_adjust '1'
	option dl_min_rate_kbps '5000'
	option dl_base_rate_kbps '20000'
	option dl_max_rate_kbps '80000'
	option ul_interface 'wan'
	option ul_adjust '1'
	option ul_min_rate_kbps '5000'
	option ul_base_rate_kbps '20000'
	option ul_max_rate_kbps '35000'
