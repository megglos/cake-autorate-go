#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/cake-autorate-go
CONF=/var/etc/cake-autorate.yaml
SHARE=/usr/share/cake-autorate

start_service() {
	mkdir -p /var/etc /var/run/cake-autorate
	# Write the messages of the converter and of the check to the system
	# log.
	local out rc
	out=$(ucode "$SHARE/uci2yaml.uc" "$CONF.new" 2>&1)
	rc=$?
	[ -n "$out" ] && echo "$out" | logger -t cake-autorate
	case $rc in
	0) ;;
	3)
		rm -f "$CONF.new"
		logger -t cake-autorate "service or all links disabled, not started"
		return 0
		;;
	*)
		rm -f "$CONF.new"
		logger -t cake-autorate "invalid configuration in /etc/config/cake-autorate"
		return 1
		;;
	esac
	out=$("$PROG" -check-config -config "$CONF.new" 2>&1)
	rc=$?
	[ -n "$out" ] && echo "$out" | logger -t cake-autorate
	if [ "$rc" -ne 0 ]; then
		rm -f "$CONF.new"
		logger -t cake-autorate "configuration check failed, not started"
		return 1
	fi
	mv "$CONF.new" "$CONF"

	procd_open_instance
	procd_set_param command "$PROG" -config "$CONF"
	# The program reads its configuration only at the start. procd restarts
	# it on a reload if the content of this file changed.
	procd_set_param file "$CONF"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cake-autorate
}
