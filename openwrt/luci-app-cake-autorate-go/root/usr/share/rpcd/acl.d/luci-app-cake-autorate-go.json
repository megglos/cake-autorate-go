{
	"luci-app-cake-autorate-go": {
		"description": "Grant access to the configuration of cake-autorate-go",
		"read": {
			"file": {
				"/var/run/cake-autorate/config-error": [ "read" ]
			},
			"ubus": {
				"file": [ "read" ]
			},
			"uci": [ "cake-autorate" ]
		},
		"write": {
			"uci": [ "cake-autorate" ]
		}
	}
}
