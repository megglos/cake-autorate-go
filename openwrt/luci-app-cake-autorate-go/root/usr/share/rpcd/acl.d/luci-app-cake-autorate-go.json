{
	"luci-app-cake-autorate-go": {
		"description": "Grant access to the configuration and the status of cake-autorate-go",
		"read": {
			"file": {
				"/var/run/cake-autorate/config-error": [ "read" ],
				"/var/run/cake-autorate/status.json": [ "read" ]
			},
			"ubus": {
				"cake-autorate": [ "qdisc" ],
				"file": [ "read" ]
			},
			"uci": [ "cake-autorate" ]
		},
		"write": {
			"ubus": {
				"cake-autorate": [ "pause", "resume" ]
			},
			"uci": [ "cake-autorate" ]
		}
	}
}
